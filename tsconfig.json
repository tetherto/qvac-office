{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "b4a": ["./types/b4a.d.ts"],
      "brittle": ["./types/brittle.d.ts"]
    }
  },
  "include": ["lib/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
